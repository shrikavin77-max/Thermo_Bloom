# ==============================================================================
# THERMO-BLOOM AI - Environment Configuration Template
# ==============================================================================

# --- Frontend (Vite / Vercel) ---
# Point to your deployed backend service (e.g., https://your-backend-service.onrender.com)
# Leave empty or omit for local development (defaults to http://localhost:8000)
VITE_API_BASE_URL=

# Optional: Override WebSocket base URL if different from VITE_API_BASE_URL
# (Normally automatically derived as wss:// from HTTPS or ws:// from HTTP)
# VITE_WS_BASE_URL=

# --- Backend (FastAPI / Render) ---
# Comma-separated list of allowed frontend origins for CORS in production
# Example: https://your-frontend-app.vercel.app,http://localhost:5173
CORS_ORIGINS=

# Optional: Regex pattern to permit dynamic Vercel preview deployment URLs
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Server Port (automatically injected by Render / cloud platforms via $PORT)
# PORT=8000

